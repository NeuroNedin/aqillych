# Скопируй в .dev.vars для локального запуска (`npm run dev`) и сквозных проверок.
# На проде эти значения ставятся через `wrangler secret put ИМЯ` — файл туда не попадает.
BOT_TOKEN=123456:ABC-твой-токен-от-BotFather
OWNER_ID=твой-числовой-telegram-id
WEBHOOK_SECRET=любая-длинная-случайная-строка

# Только для e2e/run.sh: подменяет Telegram заглушкой, чтобы проверки
# не слали настоящих сообщений. В .dev.vars для обычной разработки не нужен.
TELEGRAM_API=http://localhost:8788/bot
